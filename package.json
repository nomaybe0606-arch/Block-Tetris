{
  "name": "grid-pulse",
  "version": "2.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "build:platform": "npm run typecheck && vite build --mode platform",
    "preview": "vite preview --host 127.0.0.1",
    "audio:generate": "node scripts/generate-audio.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "package": "npm run build:platform && node scripts/verify-build.mjs ./ && node scripts/package.mjs"
  },
  "dependencies": {
    "@playgama/bridge": "2.4.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "happy-dom": "21.0.4",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
