{
  "name": "grid-tetris",
  "version": "2.0.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:vk": "vite --host 127.0.0.1 --mode vk",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "build:platform": "npm run typecheck && vite build --mode platform",
    "build:vk": "npm run typecheck && vite build --mode vk",
    "verify:vk": "node scripts/verify-vk-build.mjs",
    "deploy:vk": "npm run build:vk && node scripts/verify-vk-build.mjs --deploy && vk-miniapps-deploy",
    "promo:vk": "node scripts/create-vk-promo.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "audio:generate": "node scripts/generate-audio.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "package": "npm run build:platform && node scripts/verify-build.mjs ./ && node scripts/package.mjs"
  },
  "dependencies": {
    "@playgama/bridge": "2.4.0",
    "@vkontakte/vk-bridge": "3.0.2",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@vkontakte/vk-miniapps-deploy": "1.0.3",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
